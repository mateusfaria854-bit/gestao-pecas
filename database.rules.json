{
  "rules": {
    ".read": false,
    ".write": false,
    "gestaoPecasApp": {
      "pecas": {
        ".read": "auth != null && root.child('gestaoPecasApp/usuarios').child(auth.uid).child('role').exists()",
        ".write": "auth != null && root.child('gestaoPecasApp/usuarios').child(auth.uid).child('role').exists()"
      },
      "curvaA": {
        ".read": "auth != null && root.child('gestaoPecasApp/usuarios').child(auth.uid).child('role').exists()",
        ".write": "auth != null && root.child('gestaoPecasApp/usuarios').child(auth.uid).child('role').exists()"
      },
      "fornecedores": {
        ".read": "auth != null && root.child('gestaoPecasApp/usuarios').child(auth.uid).child('role').exists()",
        ".write": "auth != null && root.child('gestaoPecasApp/usuarios').child(auth.uid).child('role').exists()"
      },
      "envios": {
        ".read": "auth != null && root.child('gestaoPecasApp/usuarios').child(auth.uid).child('role').exists()",
        ".write": "auth != null && root.child('gestaoPecasApp/usuarios').child(auth.uid).child('role').exists()"
      },
      "baixas": {
        ".read": "auth != null && root.child('gestaoPecasApp/usuarios').child(auth.uid).child('role').exists()",
        ".write": "auth != null && root.child('gestaoPecasApp/usuarios').child(auth.uid).child('role').exists()"
      },
      "logs": {
        ".read": "auth != null && root.child('gestaoPecasApp/usuarios').child(auth.uid).child('role').val() === 'admin'",
        ".indexOn": [
          "timestamp"
        ],
        "$logId": {
          ".write": "auth != null && !data.exists() && newData.exists() && root.child('gestaoPecasApp/usuarios').child(auth.uid).child('role').exists()",
          ".validate": "newData.hasChildren(['timestamp', 'usuario', 'uid', 'tipo', 'titulo', 'detalhes']) && newData.child('uid').val() === auth.uid && newData.child('timestamp').isString() && newData.child('usuario').isString() && newData.child('titulo').isString() && newData.child('detalhes').isString() && (newData.child('tipo').val() === 'acesso' || newData.child('tipo').val() === 'cadastro' || newData.child('tipo').val() === 'baixa' || newData.child('tipo').val() === 'envio' || newData.child('tipo').val() === 'retorno' || newData.child('tipo').val() === 'exclusao')"
        }
      },
      "usuarios": {
        ".read": "auth != null && root.child('gestaoPecasApp/usuarios').child(auth.uid).child('role').val() === 'admin'",
        ".write": "auth != null && root.child('gestaoPecasApp/usuarios').child(auth.uid).child('role').val() === 'admin'",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['nome', 'email', 'role']) && (newData.child('role').val() === 'admin' || newData.child('role').val() === 'user')"
        }
      }
    }
  }
}
